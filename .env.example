# Application Settings
APP_NAME="CareerPulse AI - Personalized Career Content Generator"
ENV="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration (Defaults to SQLite for instant local execution, supports PostgreSQL)
# Example PostgreSQL: postgresql://user:password@localhost:5432/careerpulse
DATABASE_URL="sqlite:///./careerpulse.db"

# Security & Authentication
SECRET_KEY="careerpulse-super-secret-production-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Set your Gemini or OpenAI API Key. If empty or in offline demo mode, high-fidelity local AI engine is automatically utilized.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="gemini"  # "gemini" or "openai" or "local"
AI_MODEL="gemini-1.5-flash"

# Admin Initial Seed
ADMIN_EMAIL="admin@careerpulse.ai"
ADMIN_PASSWORD="AdminSecurePassword123!"

